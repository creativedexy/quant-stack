# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Data (don't commit market data to git)
data/raw/
data/processed/
data/synthetic/
data/dca/
data/deployment/
data/news/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Config secrets (never commit API keys or auth credentials)
config/secrets.yaml
config/settings.yaml
.env

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Reports (generated output, keep directory via .gitkeep)
reports/*
!reports/.gitkeep

# Logs
*.log
